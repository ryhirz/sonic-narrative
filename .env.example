# ======================================================================
# SonicNarrative 环境变量模板
# ----------------------------------------------------------------------
# 用法：复制本文件为 .env，再填入你自己的真实值
#       cp .env.example .env
#   · .env 已被 .gitignore 忽略 —— 密钥只留在本机，绝不会进仓库
#   · 不填 DASHSCOPE_API_KEY 时，平台会自动进入 Mock 模式（功能不中断）
# ======================================================================

# ---- 大模型（OpenAI 兼容协议）----
# 引擎走 OpenAI 兼容协议，换平台【只改下面三行】，代码一行不用动。
# 环境变量名沿用 DASHSCOPE_* 是代码里的历史命名；真正决定平台的是 BASE_URL。
# 留空 API Key => 翻译器 / 反向寻歌自动降级为本地 Mock / 关键词规则。
#
# 【方案 A】硅基流动 SiliconFlow —— 有永久免费模型，推荐个人项目
#   注册：https://cloud.siliconflow.cn/  ->  API 密钥
#DASHSCOPE_API_KEY=
#DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1
#QWEN_MODEL=Qwen/Qwen3-8B
#
# 【方案 B】阿里云百炼 DashScope / 通义千问
#   获取：https://bailian.console.aliyun.com/  ->  右上角「API-KEY」管理
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型别名建议用不带版本号的稳定别名（qwen-plus / qwen-flash / qwen-turbo）
QWEN_MODEL=qwen-plus
# 本项目要求严格 JSON 输出，务必保持 false（带版本号的 qwen3.x 默认开思考模式）
QWEN_ENABLE_THINKING=false

# ---- Spotify Web API：抓取真实音频特征用（见 fetch_spotify_features.py）----
# 获取地址：https://developer.spotify.com/dashboard  ->  Create app
# 只需 Client Credentials（无需用户登录授权），拿到 ID/Secret 即可
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- 平台 / 前端（可选，不填走代码默认值）----
# 后端允许的跨域来源，多个用英文逗号分隔；* 表示不限制
# SONIC_CORS_ORIGINS=*
# 前端调用后端的地址（后端换端口时改这里）
# SONIC_API_BASE=http://127.0.0.1:8000
